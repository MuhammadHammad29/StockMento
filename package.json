{
  "name": "stockmento-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run frontend:dev",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:lint": "npm run lint --prefix frontend",
    "backend:dev": "npm run start:dev --prefix backend",
    "backend:lint": "npm run lint --prefix backend",
    "backend:start": "npm run start --prefix backend"
  }
}
